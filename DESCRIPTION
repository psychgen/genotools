Package: genotools
Type: Package
Title: Facilitates Reproducible Workflows With from MoBa Genotype Data in p471
Version: 0.3.1
Authors@R: c(person("Laura", "Hegemann", email = "laura.elizabeth.hegemann@fhi.no",
