#! /usr/bin/env Rscript

# Add a common library to libPaths
if(file.exists("opt$lib")){
  .libPaths( c( .libPaths(), "opt$lib") )
}

library(ggplot2)
library(bigsnpr)
library(bigreadr)
library(data.table)
library(tidyverse)

# this scripts uses info from the following resources:
#recommended GWAS QC
#see  https://github.com/privefl/paper-misspec/tree/main/code/prepare-sumstats
#see https://privefl.github.io/bigsnpr/articles/LDpred2.html
# ew LD ref - hap-map +
#see also https://github.com/privefl/paper-infer/blob/main/code/example-with-provided-LD.R

# define some variables

out_path = "opt$out"
misc_path = "opt$misc"
NCORES = as.integer("opt$cores")
geno = "opt$geno"
sumstatDir = "opt$Sdir"
Sdir = "opt$Sdir"
shortname = "opt$shortname"
stattype = "opt$stattype"
samplesize = "opt$samplesize"
type = opt$type
sumstats_name = "opt$sumstats"
chr =  "opt$chr"
pos =   "opt$pos"
A1 =   "opt$A1"
A2 =   "opt$A2"
se =   "opt$se"
stat =   "opt$stat"
MAFname =   "opt$MAFname"
maf =   opt$MAF
info = "opt$info"
source = "opt$source"
sd_maf = opt$sd_maf

start <- Sys.time() #start time

file_log <- paste0(shortname,".log")

file.create(file_log) #create log file

cat(" -------------------------------------------------","\n",
    " Generate LDpred2-auto and infinitesimal scores. ","\n",
    " bugs and questions: Laura.Hegemann@fhi.no ","\n",
    " Adapted from https://github.com/AndreAllegrini/LDpred2, with credit to Andrea Allegrini",
    "-------------------------------------------------","\n",
    " ","\n", sep = " ", file=file_log, append=TRUE)

cat("Running QC and LDpred2 for score ",shortname, "\n",
    "File: ", sumstats_name, "\n",
    "Source: ", source, "\n",
    " ", "\n")


#print help and  options
sink(file = file_log, append = TRUE)

####################################
#######processing of options#########


###processing for --stattype option, options BETA, OR, Z

if (!(stattype %in% c("BETA", "OR", "Z"))) {
  stop("Error: Invalid effect statistic. Please specify either 'BETA', 'OR', or 'Z'")
}


###processing for --stattype option, input can be colname(s) or N total sample size###
#functions
is_integer <- function(x) { #is the input an integer / output is TRUE/FALSE
  !is.na(suppressWarnings(as.integer(x)))
  }

#process input

input <- trimws(strsplit(samplesize, ",")[[1]]) #turns sample size into vector
l <- length(input) # length of input vector
int <- all(sapply(input, is_integer))

#conditions

#continuous

if(type == FALSE & l == 1){
  if(int == TRUE){
    N_tot = as.integer(input)
    n_type = "cont_ss"
    } else {
      n_col = input
      n_type = "cont_colname"
    }
  }

if(type == FALSE & l == 2){
  stop("case_control marked as FALSE but 2 sample sizes provided. Please check that case_control and sample size arguments are correctly formated.")
  }

#case/control

if(type == TRUE & l == 1){
  #check if cont. but case_control has been left to equal true
  warning("case_control marked as TRUE but only 1 sample size provided. Ignore if sample size is effective sample size in case/control")
  if(int == TRUE) {
    N_tot = as.integer(input)
    n_type = "casecontrol_neff_ss"
    } else {
      n_col = input
      n_type = "casecontrol_neff_colname"
    }
  }

if(type == TRUE & l == 2){
  if(int == TRUE) {
    N_case = as.integer(input)[1]
    N_control = as.integer(input)[2]
    n_type = "casecontrol_ss"
    if(N_case > N_control) {
      warning("Warning: case sample size is larger than controls, check order of input values. Should be Ncase,Ncontrol")
      }
    } else {
      N_case_col = input[1]
      N_control_col = input[2]
      n_type = "casecontrol_colname"
    }
  }

###processing for --MAFname option, input can be MAF or allele freq col name(s)
#process input


if(MAFname != "NA"){
  input_frq <- trimws(strsplit(MAFname, ",")[[1]])

  l_frq <- length(input_frq)
} else {

  input_frq <- NA
  l_frq <- 0
}

if(l_frq == 2){

  FRQcase = input_frq[1]
  FRQcontrol = input_frq[2]

  if(grepl("FRQ_A", FRQcontrol)){

    warning("MAF/FRQ column header has a pattern that indicates it is allele frq for cases but is being processed as the allele frq in controls.
Check that the columns are entered in the format 'case_col_name,control_col_name'")

  }


}

if(l_frq == 1){

  if(grepl("FRQ_A|FRQ_U", input_frq)){

    warning("MAF/FRQ column header has a pattern that indicates it is allele frq for either cases or controls but only one column name has been provided.
Check that the column is for the whole sample or enter two column names in the format 'case_col_name,control_col_name'")

  }
}


cat("STAT column type is: ", paste(stattype), "\n"," ","\n", sep="",file=file_log,append=TRUE)
cat("N column type is: ", paste(n_type), "\n"," ","\n", sep="",file=file_log,append=TRUE)
cat(l_frq, " MAF/FRQ column(s) have been provided.", "\n"," ","\n", sep="",file=file_log,append=TRUE)

####################################
####Formatting Summary statistics####

cat(paste0("Analyses started at ", start),"\n"," ","\n", file=file_log,append=TRUE)

cat("Reading: ", sumstats_name, "\n"," ","\n", sep='',file=file_log,append=TRUE)

# load sumstats and convert to LDpred header format + calculate effective sample size

sumstats <- bigreadr::fread2(input = paste0(sumstatDir,sumstats_name))

cat("Loaded sumstats have: ", dim(sumstats)[1], " rows and ", dim(sumstats)[2], " columns.", "\n"," ","\n", sep="",file=file_log,append=TRUE)


cat("Sumstats header is: ", paste(names(sumstats), collapse = " ", sep = " "), "\n"," ","\n", sep="",file=file_log,append=TRUE)

#check necessary column names are present other than N

col_names = c(chr, pos, A1, A2, stat, se)

if (!all(c(chr, pos, A1, A2, stat, se) %in% names(sumstats))) {
  stop(paste0("Sumstats header is not correct. check input for options --chr, --pos, --A1, --A2,--stat, --se"))
}

cat("head() for sumstats prior to QC. \n",sep='',file=file_log,append=TRUE)

cat(paste(capture.output(head(sumstats)), collapse = "\n"),  file=file_log,append=TRUE)

###rename columns other than N stat, info, FRQ
sumstats = sumstats %>%
  dplyr::rename("chr" = chr,
                "pos" = pos,
                "a0" = A2,
                "a1" = A1,
                "beta_se" = se)

###format stat column
if(stattype == "OR"){
  over1 <- sumstats %>%
    rename("OR" = all_of(stat)) %>%
    filter(OR > 1) %>%
    nrow()

  over3 <- sumstats %>%
    rename("OR" = all_of(stat)) %>%
    filter(OR > 3) %>%
    nrow()

  if(over1 == 0) {
    stop("Stattype = OR but values indicate a beta value")
  }

  if(over3 > 1 ) {
    warning("Stattype = OR but values indicate z values (or large effects)")
  }

  sumstats = sumstats %>%
    dplyr::mutate(beta = log(!!sym(stat)))
}

if(stattype == "BETA"){
  sumstats = sumstats %>%
    dplyr::rename("beta" = all_of(stat))

  over1 <- sumstats %>%
    filter(beta > 1) %>%
    nrow()

  if(over1 > 0) {
    warning("Stattype = Beta but column has values over 1, double check inputs")
  }
}

if(stattype == "Z"){

  over2 <- sumstats %>%
    rename("Z" = all_of(stat)) %>%
    filter(Z > 2) %>%
    nrow()

  if(over2 == 0) {
    warning("Stattype = Z but values may indicate a beta or OR value (or small effects)")
  }

  sumstats = sumstats %>%
    dplyr::mutate(beta = (!!sym(stat))*beta_se)

  }

### format N col: adding or renaming N/NCAS/NCON column

if(grepl("colname", n_type)){
  if(l==1){
    if(grepl("half", n_col)){
      sumstats = sumstats %>%
        dplyr::rename("n_eff" = all_of(n_col)) %>%
        dplyr::mutate(n_eff = 2*n_eff)

    warning("sample size column name contains 'half' indicating it is half the effective sample size, rename the column to not include 'half' if this is incorrect'")
    } else {

      sumstats = sumstats %>%
        dplyr::rename("n_eff" = all_of(n_col))

    }

  } else {
    sumstats = sumstats %>%
      dplyr::rename("Ncas" = all_of(N_case_col),
                    "Ncon" = all_of(N_control_col))
    if(sumstats$Ncas[1] > sumstats$Ncon[1]){

      warning("Warning: case sample size is larger than controls, check order of input values. Should be Ncase,Ncontrol")

    }

    if(length(unique(sumstats$Ncas)) == 1){

      warning("data indicates max sample size is entered, this may decrease predictive value of PGS, particularly in the auto model.
              If using a meta-analysis case/control study make sure Neff is sum of the effective sample sizes of each study instead of calculated from the total numbers of cases and controls.
              Consider estimating per-variant N or using a different model to estimate PGS")
    }
  }

}

if(grepl("ss", n_type)) {

  warning("data indicates max sample size is entered, this may decrease predictive value of PGS, particularly in the auto model.
              If using a meta-analysis case/control study make sure Neff is sum of the effective sample sizes of each study instead of calculated from the total numbers of cases and controls.
              Consider estimating per-variant N or using a different model to estimate PGS")
  if(l==1){
    sumstats = sumstats %>%
      dplyr::mutate("n_eff" = all_of(N_tot))
  } else {
    sumstats = sumstats %>%
      dplyr::mutate("Ncas" = all_of(N_case),
                    "Ncon" = all_of(N_control))
  }


}


### format MAF and allele frq columns

## check if MAF is actually MAF (i.e., max value is .5 or less) / Make MAF col / format FRQ columns
if(any(input_frq %in% colnames(sumstats))) {

  if(l_frq == 1){

  sumstats = sumstats %>%
    rename("FRQ" = all_of(MAFname))

  sumstats$MAF <- ifelse(sumstats$FRQ <= .5, sumstats$FRQ, (1-sumstats$FRQ))

  if(sum(sumstats$FRQ > 0.5) == 0) {


    sumstats = sumstats %>% #removes FRQ col if input was actually maf and not frq of effect allele
      select(-c(FRQ))
  }
  }
  if(l_frq == 2){

    if(all(c("Ncon", "Ncas") %in% colnames(sumstats))) {

     sumstats <- sumstats %>%
      dplyr::rename("FRQcas" = FRQcase,
                    "FRQcon" = FRQcontrol)
     sumstats <- sumstats %>%
       dplyr::mutate(FRQ = ((FRQcas*Ncas) + (FRQcon*Ncon)) / (Ncas + Ncon),
                     MAF = ifelse(FRQ <= .5, FRQ, (1-FRQ)))

    } else {
      stop("Two allele frq columns entered, need sample sizes for cases and controls")
    }

  }

}

cat("\n", "\n", "Sumstats header after renaming main cols is: ", paste(names(sumstats), collapse = " ", sep = " "), "\n"," ","\n", sep="",file=file_log,append=TRUE)

cat(paste(capture.output(head(sumstats)), collapse = "\n"),  file=file_log,append=TRUE)

cat( "\n","\n","Starting sumstats QC...","\n"," ","\n", file=file_log,append=TRUE)

##calculate effective sample size

if(type == T & l == 2){

  sumstats <- sumstats %>%
    dplyr::mutate(n_eff = 4 / (1 / Ncas + 1 / Ncon))
}


#save sumstats after formatting

fwrite(sumstats, paste0(out_path,"/",shortname,"_sumstats_after_formating.txt.gz"), col.names=T,row.names=F,quote=F)


##############################
##########basic QC############

## make sure all alleles are upper case
sumstats$a1 <- factor(toupper(sumstats$a1), c("A", "C", "G", "T"))
sumstats$a0 <- factor(toupper(sumstats$a0), c("A", "C", "G", "T"))

## make sure chr col is type int

if(!is.integer(sumstats$chr)){
  sumstats$chr <- as.integer(sumstats$chr)
}


##filter on MAF and INFO

if("MAF" %in% colnames(sumstats)) {

  cat("N = ", sum(sumstats$MAF < maf), "have been discarded because MAF <", maf,"\n", sep='',file=file_log,append=TRUE)

  sumstats <-sumstats[sumstats$MAF >= maf, ]

} else { cat("No MAF column name provided. Couldn't perform filtering base on minor allele frequency \n", sep='',file=file_log,append=TRUE)
  }

if(info %in% colnames(sumstats)) {

  sumstats = sumstats %>%
    rename("INFO" = all_of(info))


  cat("N = ", sum(sumstats$INFO < 0.6), "have been discarded because INFO < 0.6 ","\n", sep='',file=file_log,append=TRUE)
  cat("Mean Info score = ", mean(sumstats$INFO, na.rm = TRUE),"\n", sep='',file=file_log,append=TRUE)

  sumstats <-  sumstats[sumstats$INFO >= 0.6,]

}else{
  cat("No INFO column provided.Couldn't perform filtering based on INFO score. \n",sep='',file=file_log,append=TRUE) }


## Match to LD ref panel

cat("matching to ldref panel...\n \n",sep='',file=file_log,append=TRUE)

map_ldref <- readRDS(paste0(misc_path,"map_hm3_plus.rds")) #read reference map

(info_snp <- tibble::as_tibble(snp_match(sumstats, map_ldref, return_flip_and_rev = T)))

cat("There were: ", sum( vctrs::vec_duplicate_detect(sumstats[, c("chr","pos")]))," duplicated physical positions in GWAS data.\n" ," ","\n", sep='',file=file_log,append=TRUE)

# match sumstats with reference data
cat(" N = ", dim(info_snp)[1], "SNPs have been matched with reference data (i.e. HapMap3 + )\n",
    "N =  ",sum(info_snp$`_FLIP_`), "SNPs were flipped\n",
    "N =  ",sum(info_snp$`_REV_`), "were reversed.\n",
    "\n",file=file_log,append=TRUE)

#drop NAs and make sure order is the same with SD file below
info_snp <- tidyr::drop_na(tibble::as_tibble(info_snp))

#drop SNP if only a few are flipped
if(sum(info_snp$`_FLIP_`) < (nrow(info_snp)*0.001)) {


  cat("N =  ",sum(info_snp$`_FLIP_`), "flipped SNPs were removed \n",
      file=file_log,append=TRUE)

  info_snp <- info_snp %>%
    filter(`_FLIP_` != TRUE)

}


chi2 <- with(info_snp, (beta / beta_se)^2)
cat("Mean chi^2 = ",mean(chi2,na.rm=T),".\n",sep='',file=file_log,append=TRUE)

lgc <- median(chi2,na.rm=T)/qchisq(0.5,1)
cat("Lambda GC = ",lgc,".\n",sep='',file=file_log,append=TRUE)


#############################
#######recommended QC########

cat("starting sd comparision...\n",sep='',file=file_log,append=TRUE)

#calculating SD in reference and sumstats

sd_ldref <- with(info_snp, sqrt(2 * af_UKBB * (1 - af_UKBB)))

if(sd_maf == TRUE & ("FRQ" %in% colnames(sumstats))){

  sd_ldref <- with(info_snp, sqrt(2 * FRQ * (1 - FRQ)))

  cat("estmated sd from allele frq column provided.\n",sep='',file=file_log,append=TRUE)

}

if(type == T){  #if GWAS trait is binary

  cat("treating GWAS trait as binary.\n",sep='',file=file_log,append=TRUE)

  sd_ss <- with(info_snp, 2 / sqrt(n_eff * beta_se^2 + beta^2)) #sumstats sd

  if("INFO" %in% colnames(sumstats)) {

    sd_ss <- sd_ss / sqrt(info_snp$INFO)

    cat("adjusting estimated sd from sumstats using info column \n", sep='',file=file_log,append=TRUE)
  }

}else{ #if it is continuous

  cat("treating GWAS trait as continuous.\n",sep='',file=file_log,append=TRUE)

  #consistent with e.g.: https://github.com/privefl/paper-misspec/blob/main/code/prepare-sumstats-bbj/height.R


  sd_ss = with(info_snp, 1 / sqrt(n_eff * beta_se^2 + beta^2))

  if("INFO" %in% colnames(sumstats)) {
    sd_ss <- sd_ss / sqrt(info_snp$INFO)

    cat("adjusting estimated sd from sumstats using info column \n", sep='',file=file_log,append=TRUE)
  }

  sd_ss = sd_ss / quantile(sd_ss, 0.99) * sqrt(0.5)

}

### QC 1 in  10.1016/j.xhgg.2022.100136, originally in 10.1093/bioinformatics/btaa1029

is_bad <- sd_ss < (0.5 * sd_ldref) | sd_ss > (sd_ldref + 0.1) | sd_ss < 0.1 | sd_ldref < 0.05

### QC 2 in  10.1016/j.xhgg.2022.100136

is_bad2 <- sd_ss < (0.7 * sd_ldref) | sd_ss > (sd_ldref + 0.1) | #note all SNPs in QC1 will be in this QC - kept so can hash out these lines and change line 515 if only want QC1
  sd_ss < 0.1 | sd_ldref < 0.05

if("FRQ" %in% colnames(sumstats)) {


  info_snp$freq2 <- ifelse(info_snp$beta * sumstats$beta[info_snp$`_NUM_ID_.ss`] < 0,
                            1 - info_snp$FRQ, info_snp$FRQ)

  is_bad3 <- with(info_snp, abs(af_UKBB - freq2) > 0.1)

  is_bad_qc2 <- is_bad2 | is_bad3

  cat("QC of sumstats performed: sd_ss < (0.7 * sd_ldref) or  sd_ss > (sd_ldref + 0.1) or sd_ss < 0.1 or  sd_ldref < 0.05  or af_UKBB - af_ss > 1; QC 2 in  10.1016/j.xhgg.2022.100136  \n
if you need Q1 in  10.1016/j.xhgg.2022.10013 (originally in 10.1093/bioinformatics/btaa1029) which was the previous QC used in earlier versions of genotools then edit line 529 of the shortname_pipl.R file to is_bad_qc2 <- is_bad and rerun the job.  \n", sep='',file=file_log,append=TRUE)

} else {
  is_bad_qc2 <- is_bad2

  cat("QC of sumstats performed: sd_ss < (0.7 * sd_ldref) or  sd_ss > (sd_ldref + 0.1) or sd_ss < 0.1 or  sd_ldref < 0.05;QC 2 when allele frq in sumstats is not avail in  10.1016/j.xhgg.2022.100136 \n
if you need Q1 in  10.1016/j.xhgg.2022.10013 (originally in 10.1093/bioinformatics/btaa1029) which was the previous QC used in earlier versions of genotools then edit line 535 of the shortname_pipl.R file to is_bad_qc2 <- is_bad and rerun the job.  \n", sep='',file=file_log,append=TRUE)

}

#plot SD SS vs SD REF
dat_sd <- data.frame(sd_ldref, sd_ss,is_bad, is_bad2, is_bad_qc2)


qplot(sd_ldref, sd_ss, color = is_bad_qc2, alpha = I(0.5),
      data = slice_sample(dat_sd, n = 50000)) +
  theme_bigstatsr() +
  coord_equal() +
  scale_color_viridis_d(direction = -1) +
  geom_abline(linetype = 2, color = "red") +
  labs(x = "Standard deviations derived from allele frequencies of the LD reference",
       y = "Standard deviations derived from the summary statistics",
       color = "Removed?")

ggsave(paste0(out_path,"/sd_", shortname,".png"), width = 10, height = 7)


##when more than 50% of variants have discordant SD - imputing Neff ## double check ## add remove Neff imp where needed

if(sum(is_bad_qc2, na.rm = T) > (length(is_bad_qc2)*0.5)) {

  cat("WARNING: More than half the variants had a discordant SD. Imputing Neff.\n
      Double check your input sumstats: reference population, per-variant sample size, effective N.\n
      Double check effective N column is not half the effective N \n\n\n",file=file_log,append=TRUE) # see: https://github.com/privefl/bigsnpr/issues/281.
  if(type == T){
    #see eq 4 and 5 here  https://www.sciencedirect.com/science/article/pii/S2666247722000525?via%3Dihub#sec3.2

    info_snp$n_eff_imp <- (4 / sd_ldref^2 - info_snp$beta^2) / info_snp$beta_se^2

    #correcting difference in per allele effect size
    info_snp$n_eff_imp <- with(info_snp, ifelse(n_eff_imp >= .67 * quantile(n_eff_imp,.90), n_eff_imp, NA))  # filtering small values doi: 10.1093/bioinformatics/btw613
    #info_snp$n_eff_imp <- with(info_snp, ifelse(n_eff_imp < 1.1* max(n_eff, na.rm = TRUE), n_eff_imp, NA))  #restricting to 1.1 x max sample size

    info_snp$n_eff_2 <- median(info_snp$n_eff_imp, na.rm=T)

    #info_snp$n_eff_3 <- quantile(info_snp$n_eff_imp, 0.8, na.rm=T)

    sd_ss_2 <- with(info_snp, 2 / sqrt(n_eff_2 * beta_se^2 + beta^2))

    if("INFO" %in% colnames(sumstats)) {

      sd_ss_2 <- sd_ss_2 / sqrt(info_snp$INFO)

      cat("adjusting estimated sd from imputed N and sumstats using info column \n", sep='',file=file_log,append=TRUE)
    }

  }else{  #fix

    cat("WARNING: Be extra sceptic of median imputation for contnuous traits.\n
      Double check source code, line 601.\n\n",file=file_log,append=TRUE)

    info_snp$n_eff_imp <- (1 / (sd_ldref^2 - info_snp$beta^2)) / info_snp$beta_se^2

    info_snp$n_eff_imp <- with(info_snp, ifelse(n_eff_imp >= .67 * quantile(n_eff_imp,.90), n_eff_imp, NA))

    info_snp$n_eff <- median(info_snp$n_eff_imp, na.rm=T)

    sd_y = with(info_snp, sqrt(quantile(0.5 * (n_eff * beta_se^2 + beta^2), 0.01))) # https://github.com/privefl/bigsnpr/issues/349

    sd_ss_2 = with(info_snp, sd_y / sqrt(n_eff * beta_se^2 + beta^2))

    if("INFO" %in% colnames(sumstats)) {

      sd_ss_2 <- sd_ss_2 / sqrt(info_snp$INFO)

      cat("adjusting estimated sd from imputed N and sumstats using info column \n", sep='',file=file_log,append=TRUE)
    }

    sd_ss_2 = sd_ss / quantile(sd_ss_2, 0.99) * sqrt(0.5)
  }

  cat("N = ",sum(is.na(info_snp$n_eff_imp)), " SNPs have been filtered to correct for low sample size.\n"," ","\n",sep='',file=file_log,append=TRUE)

  cat("new imputed median N = ", median(info_snp$n_eff_imp, na.rm=T) ,"\n", file=file_log,append=TRUE)

  is_bad_imp <- sd_ss_2 < (0.7 * sd_ldref) | sd_ss_2 > (sd_ldref + 0.1) | sd_ss_2 < 0.1 | sd_ldref < 0.05

  cat(sum(is_bad_imp, na.rm = T)," SNPs are bad.\n"," ","\n", sep='',file=file_log,append=TRUE)


  #plot SD SS vs SD REF

  qplot(sd_ldref, sd_ss, color = is_bad, alpha = I(0.5)) +
    theme_bigstatsr() +
    coord_equal() +
    scale_color_viridis_d(direction = -1) +
    geom_abline(linetype = 2, color = "red") +
    labs(x = "Standard deviations derived from allele frequencies of the LD reference",
         y = "Standard deviations derived from the summary statistics",
         color = "Removed?")

  ggsave(paste0(out_path,"/sd_impute", shortname,".png"), width = 10, height = 7)


  df_beta <- info_snp[!is_bad_imp, ] #remove bad SNPs

  cat("After QC there are: ", dim(df_beta)[1], " SNPs.\n"," ","\n",sep='',file=file_log,append=TRUE)

}


if(sum(is_bad_qc2, na.rm = T) < (length(is_bad_qc2)*0.5)) {
df_beta <- info_snp[!is_bad_qc2, ]
cat(sum(is_bad_qc2, na.rm = T)," SNPs are bad.\n"," ","\n", sep='',file=file_log,append=TRUE)

}


##############################
####Running LDpred2 models####

#load test data
obj.bigsnp <- snp_attach(paste0(geno))

# shortcut for geno test set
G <- obj.bigsnp$genotypes

map_test <- dplyr::transmute(obj.bigsnp$map,
                             chr = as.integer(chromosome), pos = physical.pos,
                             a0 = allele2, a1 = allele1)

#remove duplicates (if any) in test data
dups <- vctrs::vec_duplicate_detect(map_test[, c("chr","pos")])
if (any(dups)) {
  cat("There are: ", sum( vctrs::vec_duplicate_detect(map_test[, c("chr","pos")])), " duplicated physical positions in test data.\n" ," ","\n", sep='',file=file_log,append=TRUE)
  cat("removing duplicated...\n"," ","\n",file=file_log,append=TRUE)
  map_test <-  map_test[!dups, ] }

# match with variants in test data and prepare files for matrix multiplication later
cat("Matching with test data...\n"," ","\n",file=file_log,append=TRUE)

map_pgs <- df_beta[1:4]; map_pgs$beta <- 1

map_pgs2 <- snp_match(map_pgs, map_test, return_flip_and_rev = T)

# match test data with reference data
cat(" N = ", dim(map_pgs2)[1], "SNPs have been matched with test data\n",
    "N =  ",sum(map_pgs2$`_FLIP_`), "SNPs were flipped\n",
    "N =  ",sum(map_pgs2$`_REV_`), "were reversed.\n",
    "\n",file=file_log,append=TRUE)

in_test <- vctrs::vec_in(df_beta[, c("chr", "pos")], map_pgs2[, c("chr", "pos")])

df_beta <- df_beta[in_test, ]#%>%
  #filter(!is.na(n_eff_imp))

cat("There are: ", dim(df_beta)[1], " SNPs in common with test data.\n"," ","\n",sep='',file=file_log,append=TRUE)

# LDSC
cat("Running LDSC...\n"," ","\n",file=file_log,append=TRUE)

(ldsc <- with(df_beta, snp_ldsc(ld, ld_size = nrow(map_ldref),
                                chi2 = (beta / beta_se)^2,
                                sample_size = n_eff,
                                ncores = NCORES)))

h2_est <- ldsc[["h2"]]

cat(paste(names(ldsc),ldsc, sep ="=", collapse="; "),"\n"," ","\n", file=file_log, append=TRUE)

#ldsc ratio
ldsc_int <- ldsc[["int"]]
mchi2 <- mean(chi2,na.rm=T)
ldscRATIO <- (ldsc_int - 1) /  (mchi2 - 1)
cat("Ratio = ",ldscRATIO,".\n",sep='',file=file_log,append=TRUE)

cat("Running sparse matrix...\n"," ","\n",file=file_log,append=TRUE)

#sparse matrix
for (chr in 1:22) {

  cat(chr, ".. ", sep = "")

  ## indices in 'df_beta'
  ind.chr <- which(df_beta$chr == chr)
  ## indices in 'map_ldref'
  ind.chr2 <- df_beta$`_NUM_ID_`[ind.chr]
  ## indices in 'corr_chr'
  ind.chr3 <- match(ind.chr2, which(map_ldref$chr == chr))

  corr_chr <- readRDS(paste0(misc_path,"LDref/LD_with_blocks_chr", chr, ".rds"))[ind.chr3, ind.chr3]

  if (chr == 1) {
    corr <- as_SFBM(corr_chr, paste0(out_path,"/corr_chr"), compact = TRUE)
  } else {
    corr$add_columns(corr_chr, nrow(corr))
  }
}

file.size(corr$sbk) / 1024^3  # file size in GB



cat("Running LDpred2-inf...\n"," ","\n",file=file_log,append=TRUE)

beta_inf <- snp_ldpred2_inf(corr, df_beta, h2 = h2_est)

beta_inf2 <- cbind(df_beta[,1:4], beta_inf) #bind with chr:pos:a0:a1

#save weights
fwrite(beta_inf2, paste0(out_path,"/",shortname,"_beta_inf.txt.gz"), col.names=T,row.names=F,quote=F)

pred_inf <- big_prodVec(G, beta_inf * map_pgs2$beta,
                        ind.col = map_pgs2[["_NUM_ID_"]],
                        ncores = NCORES)


final_pred_inf <- cbind(obj.bigsnp$fam,pred_inf)		#bind with test map

#save final scores
fwrite(final_pred_inf, paste0(out_path,"/",shortname,"_pred_inf.txt.gz"), col.names=T, row.names=F, quote = F)


cat("Running LDpred2-auto...\n"," ","\n", file=file_log,append=TRUE)

# LDpred2-auto
multi_auto <- snp_ldpred2_auto(corr, df_beta, h2_init = h2_est,
                               vec_p_init = seq_log(1e-4, 0.9, 30),
                               allow_jump_sign = FALSE, shrink_corr = 0.95,
                               ncores = NCORES)

#save weights
saveRDS(multi_auto, file = paste0(out_path,"/",sumstats_name,"_multi_beta_auto.rds"))

#check that chains converged
auto <- multi_auto[[1]]  # first chain


plot_grid(
  qplot(y = auto$path_p_est) +
    theme_bigstatsr() +
    geom_hline(yintercept = auto$p_est, col = "blue") +
    scale_y_log10() +
    labs(y = "p"),
  qplot(y = auto$path_h2_est) +
    theme_bigstatsr() +
    geom_hline(yintercept = auto$h2_est, col = "blue") +
    labs(y = "h2"),
  ncol = 1, align = "hv"
)
ggsave(paste0(out_path,"/auto_chains", shortname,".qc_sd.png"), width = 10, height = 7)

# Filter outlier betas and average remaining ones - new recommended way
(range <- sapply(multi_auto, function(auto) diff(range(auto$corr_est))))
(keep <- (range > (0.95 * quantile(range, 0.95))))
final_beta_auto <- rowMeans(sapply(multi_auto[keep], function(auto) auto$beta_est))

#save final betas
final_beta_auto2 <- cbind(df_beta[,1:4], final_beta_auto) #bind with chr:pos:a0:a1
write.table(final_beta_auto2, paste0(out_path,"/",shortname,"_final_beta_auto.txt"), col.names=T,row.names=F,quote=F)

#calculate score (matrix multiplication)
final_pred_auto <- big_prodVec(G, final_beta_auto * map_pgs2$beta,
                               ind.col = map_pgs2[["_NUM_ID_"]],
                               ncores = NCORES)

final_pred_auto <- cbind(obj.bigsnp$fam,final_pred_auto)		#bind with test fam

write.table(final_pred_auto, paste0(out_path,"/",shortname,"_pred_auto.txt.gz"), col.names=T, row.names=F, quote = F)

#remove sbk
file.remove(paste0(out_path, "/corr_chr.sbk"))

end <- Sys.time()

cat(paste0("Analyses ended at ", end)," ","\n", file=file_log,append=TRUE)

cat(paste0("(Analyses took: ", round(as.numeric(difftime(end, start , units="mins")),digits=1) ," minutes)"),"\n"," ","\n", file=file_log,append=TRUE)

cat("###END###\n",file=file_log,append=TRUE)

#move logs and figures in out folder
system(paste('mv ', file_log ,out_path, sep = " "))


